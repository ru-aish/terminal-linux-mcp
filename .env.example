# Terminal MCP
MCP_HOST=127.0.0.1
MCP_PORT=8011
MCP_TRANSPORT=streamable-http
MCP_PATH=/mcp
MCP_WORKSPACE=$HOME/mcp_workspace
MCP_LOG_DIR=$HOME/.gpt_terminal_mcp_logs
MCP_START_TIMEOUT=30

# GPT-specific instruction and thread-accounting home. This is intentionally
# separate from Codex's ~/.codex directory.
MCP_GPT_HOME=$HOME/.GPT
MCP_BOOTSTRAP_MAX_CHARS=100000
# Append an active goal to the first tool result after this many unseen seconds.
MCP_GOAL_REMINDER_SECONDS=900
# Maximum raw image bytes returned by watch_image before base64 expansion.
MCP_WATCH_IMAGE_MAX_BYTES=20971520

# Dependency bootstrap behavior.
MCP_AUTO_SETUP=1
# MCP_AUTO_INSTALL_NGROK=1
# MCP_VENV_DIR=/absolute/path/to/venv

# Keep downstream MCP processes alive between calls. Idle connections close after
# this many seconds; set 0 to disable idle cleanup.
MCP_PROXY_IDLE_TIMEOUT=1800

# Strongly recommended for ngrok and required by start.sh unless an ngrok
# Traffic Policy is configured. Generate one with: openssl rand -hex 32
# MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Browser-friendly protection for /dashboard. The login form stores this in an
# HttpOnly cookie. Keep it separate from the MCP bearer token when possible.
# MCP_DASHBOARD_TOKEN=replace-with-a-long-random-token

# Optional: set this instead of running `ngrok config add-authtoken ...`.
# Never commit a real token.
# NGROK_AUTHTOKEN=

# Optional: reserved ngrok domain/URL.
# NGROK_URL=https://your-name.ngrok.app

# Optional: ngrok Traffic Policy file.
# NGROK_TRAFFIC_POLICY_FILE=/absolute/path/to/policy.yml

# Local-only mode, useful for tests.
# MCP_SKIP_NGROK=1

# Dangerous: expose the terminal without MCP_BEARER_TOKEN or a Traffic Policy.
# MCP_ALLOW_UNAUTHENTICATED_PUBLIC=1

# ChatGPT task watchdog. Uses the running Codex desktop app's internal normal-chat
# client through CDP; it does not launch Chrome or operate the visible UI.
MCP_CHAT_WATCHDOG_ENABLED=1
MCP_CHAT_WATCHDOG_ADAPTER=codex-internal
# MCP_CHAT_WATCHDOG_QUEUE=   # Leave unset to use platform-native macOS/Linux defaults
# MCP_CHAT_WATCHDOG_STATE=   # Leave unset to use platform-native macOS/Linux defaults
# MCP_CHAT_WATCHDOG_COMPLETED=   # Leave unset to use platform-native macOS/Linux defaults
MCP_CHAT_WATCHDOG_CDP=http://127.0.0.1:9222
MCP_CHAT_WATCHDOG_INTERVAL_SECONDS=300
MCP_CHAT_WATCHDOG_RETRY_SECONDS=300
MCP_CHAT_WATCHDOG_INITIAL_DELAY_SECONDS=15
MCP_CHAT_WATCHDOG_DRY_RUN=0
MCP_CHAT_WATCHDOG_AUTO_START_APP=1
# macOS default: /usr/bin/open -a "Codex" --args
# Linux default: /usr/bin/codex-desktop
# MCP_CHAT_WATCHDOG_APP_COMMAND=/usr/bin/open -a "Codex" --args
MCP_CHAT_WATCHDOG_APP_START_TIMEOUT_SECONDS=30
MCP_CHAT_WATCHDOG_INTERNAL_TIMEOUT_SECONDS=10
MCP_CHAT_WATCHDOG_REQUIRE_HIGH=1
MCP_CHAT_WATCHDOG_MODEL=
MCP_CHAT_WATCHDOG_THINKING_EFFORT=extended
MCP_CHAT_WATCHDOG_STREAM_TIMEOUT_SECONDS=3600
MCP_CHAT_WATCHDOG_STALE_GENERATION_SECONDS=600
MCP_CHAT_WATCHDOG_MAX_CONTINUE_ATTEMPTS=20
MCP_CHAT_WATCHDOG_PRE_SEND_CONFIRM_SECONDS=1.25
# MCP_CHAT_WATCHDOG_CONTINUE_MESSAGE=...

# Durable sub-agent gateway. The domain database keeps relationships, tasks,
# mailboxes, and events. The gateway database keeps physical request operations,
# rate windows, claims, circuit breakers, and canonical lifecycle state.
# MCP_CHAT_AGENT_DB=   # Leave unset to use platform-native macOS/Linux defaults
# MCP_CHAT_GATEWAY_DB=   # Leave unset to use platform-native macOS/Linux defaults
MCP_CHAT_AGENT_ENABLED=1
MCP_CHAT_AGENT_MAX_ACTIVE_CHILDREN=5
MCP_CHAT_AGENT_SYNC_SECONDS=600
MCP_CHAT_AGENT_MAX_CONTINUE_ATTEMPTS=20
CHAT_GATEWAY_CDP_ENDPOINT=http://127.0.0.1:9222
CHAT_GATEWAY_MODEL_SLUG=gpt-5.6-terra
CHAT_GATEWAY_STREAM_START_TIMEOUT=30
CHAT_GATEWAY_CDP_TIMEOUT=45
# Override only with another reviewed runtime behavior prompt.
# MCP_CORE_BEHAVIOR_PROMPT=/absolute/path/to/terminal_mcp_core_behavior.md
