# Terminal MCP
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=streamable-http
MCP_PATH=/mcp
MCP_WORKSPACE=$HOME/mcp_workspace
MCP_LOG_DIR=$HOME/.mcp_terminal_logs
MCP_START_TIMEOUT=30

# Keep downstream MCP processes alive between calls. Idle connections close after
# this many seconds; set 0 to disable idle cleanup.
MCP_PROXY_IDLE_TIMEOUT=1800

# Strongly recommended for ngrok and required by start.sh unless an ngrok
# Traffic Policy is configured. Generate one with: openssl rand -hex 32
# MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Optional: set this instead of running `ngrok config add-authtoken ...`.
# Never commit a real token.
# NGROK_AUTHTOKEN=

# Optional: reserved ngrok domain/URL.
# NGROK_URL=https://your-name.ngrok.app

# Optional: ngrok Traffic Policy file.
# NGROK_TRAFFIC_POLICY_FILE=/absolute/path/to/policy.yml

# Local-only mode, useful for tests.
# MCP_SKIP_NGROK=1

# Dangerous: expose the terminal without MCP_BEARER_TOKEN or a Traffic Policy.
# MCP_ALLOW_UNAUTHENTICATED_PUBLIC=1
