[Unit]
Description=Dedicated ChatGPT desktop runtime supervisor
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPOSITORY@
EnvironmentFile=-%h/.config/terminal-mcp/chat-runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=KDE_APPLICATIONS_AS_SCOPE=0
ExecStartPre=@PYTHON@ @REPOSITORY@/chat_runtime_supervisor.py --cleanup
ExecStart=@PYTHON@ @REPOSITORY@/chat_runtime_supervisor.py
ExecStopPost=@PYTHON@ @REPOSITORY@/chat_runtime_supervisor.py --cleanup
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s
OOMPolicy=stop

[Install]
WantedBy=default.target
