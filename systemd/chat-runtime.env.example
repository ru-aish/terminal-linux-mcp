# Physical ChatGPT application. Keep this absolute and shell-free.
CHAT_RUNTIME_COMMAND=/usr/bin/codex-desktop
CHAT_RUNTIME_APP_ID=codex-desktop

# Layered local health endpoints.
CHAT_RUNTIME_WEBVIEW_URL=http://127.0.0.1:5175/index.html
CHAT_RUNTIME_CDP_ENDPOINT=http://127.0.0.1:9222

# One ownership boundary for PID files, launch IPC, and supervisor state.
# Defaults already resolve from HOME and XDG_RUNTIME_DIR. The installer writes
# concrete absolute values. Override only with absolute paths.
# CHAT_RUNTIME_STATE_DIR=/home/USER/.local/state/codex-desktop
# CHAT_RUNTIME_SOCKET_DIR=/run/user/UID/codex-desktop
# CHAT_RUNTIME_STATUS_PATH=/home/USER/.local/state/codex-desktop/supervisor-status.json

# Recovery policy. Three failed probes at 10 seconds means approximately 30 seconds
# of confirmed degradation after the initial startup grace.
CHAT_RUNTIME_STARTUP_GRACE=45
CHAT_RUNTIME_PROBE_INTERVAL=10
CHAT_RUNTIME_FAILURE_THRESHOLD=3
CHAT_RUNTIME_RESTART_BACKOFF=5
CHAT_RUNTIME_STOP_TIMEOUT=20

# Terminal MCP control-plane settings.
MCP_CHAT_RUNTIME_SERVICE=codex-desktop-runtime.service
MCP_CHAT_RUNTIME_WEBVIEW_URL=http://127.0.0.1:5175/index.html
MCP_CHAT_RUNTIME_RECOVERY_TIMEOUT=90
MCP_CHAT_RUNTIME_POLL_INTERVAL=1
