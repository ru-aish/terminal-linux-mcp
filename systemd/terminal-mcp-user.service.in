[Unit]
Description=Terminal MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR_Q@
EnvironmentFile=@ENV_FILE_Q@
ExecStart=@PYTHON_Q@ @SCRIPT_Q@ --transport streamable-http --host ${MCP_HOST} --port ${MCP_PORT}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=default.target
